<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VienCMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-primary tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">
                    VienCMS<span class="text-danger">.Fashion</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="mx-auto my-3 my-lg-0 w-100" style="max-width: 480px;">
                        <div class="input-group rounded-pill overflow-hidden border">
                            <input type="text" id="search-input" class="form-control border-0 px-3 bg-light shadow-none" placeholder="Tìm mẫu đầm đẹp, sơ mi công sở..." />
                            <button class="btn btn-primary px-4 border-0" type="button" onclick="searchProducts()">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <ul class="navbar-nav align-items-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link position-relative p-2" href="#">
                                <i class="bi bi-bag-heart fs-4 text-dark"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart-count">0</span>
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="text-secondary small me-1">Xin chào,</span>
                                <span class="text-dark fw-semibold">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-link text-decoration-none text-dark fw-medium btn-sm px-2" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light pt-5 pb-4 border-top border-secondary border-opacity-20">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-12 col-lg-4">
                    <h5 class="fw-bold text-white mb-3">VienCMS<span class="text-danger">.Fashion</span></h5>
                    <p class="text-muted small lh-lg mb-0">Hệ thống kinh doanh và định hình phong cách thời trang cao cấp độc quyền. Cam kết đem lại trải nghiệm mua sắm tối ưu và dịch vụ hoàn hảo.</p>
                </div>
                <div class="col-6 col-sm-4 col-lg-2">
                    <h6 class="fw-bold text-white text-uppercase tracking-wider mb-3">Chính sách</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="#" class="text-muted text-decoration-none text-hover-white transition">Giao hàng tận nơi</a></li>
                        <li><a href="#" class="text-muted text-decoration-none text-hover-white transition">Đổi trả trong 30 ngày</a></li>
                        <li><a href="#" class="text-muted text-decoration-none text-hover-white transition">Bảo mật khách hàng</a></li>
                    </ul>
                </div>
                <div class="col-6 col-sm-4 col-lg-3">
                    <h6 class="fw-bold text-white text-uppercase tracking-wider mb-3">Thông tin liên hệ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small text-muted">
                        <li class="d-flex align-items-start gap-2"><i class="bi bi-geo-alt mt-1"></i> Khu công nghệ cao, Võ Chí Công, Quận 9, TP. HCM</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-telephone"></i> 090xxxxxxx</li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-envelope"></i> support@viencms.retail</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary border-opacity-30 my-4">
            <div class="text-center text-muted small">
                &copy; 2026 <span class="text-white fw-semibold">VienCMS Retail</span>. Mọi quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>