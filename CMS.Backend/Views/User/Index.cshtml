@model List<CMS.Data.Entities.User>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark font-weight-bold m-0">QUẢN LÝ THÀNH VIÊN</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">+ Thêm thành viên mới</a>
    </div>

    <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
        <thead class="table-light text-secondary">
            <tr>
                <th style="width: 80px;">ID</th>
                <th>Tên Đăng Nhập</th>
                <th>Họ Và Tên</th>
                <th>Quyền Hạn</th>
                <th class="text-center" style="width: 200px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="font-weight-bold">@item.Username</td>
                        <td>@item.FullName</td>
                        <td>
                            @if (item.Role == "Admin" || item.Role == "Administrator")
                            {
                                <span class="badge bg-danger">@item.Role</span>
                            }
                            else if (item.Role == "Editor")
                            {
                                <span class="badge bg-info text-dark">@item.Role</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Role</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @item.Username không?')">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Chưa có dữ liệu thành viên nào.</td>
                </tr>
            }
        </tbody>
    </table>
</div>