@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Chỉnh sửa Danh mục";
}

<div class="container mt-4">
    <div class="card shadow-sm" style="max-width:700px;">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHỈNH SỬA DANH MỤC</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Ảnh đại diện:</label>
                    <div class="mb-2">
                        <img id="previewImage" src="@Model.ImageUrl"
                             style="max-width: 150px; height: 150px; object-fit: cover;"
                             class="img-thumbnail"
                             onerror="this.src='https://placehold.co/150'" />
                    </div>
                    <label class="form-label">Chọn ảnh mới (nếu muốn thay đổi):</label>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" onchange="previewSelectedImage(this)" />
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Cập nhật</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewSelectedImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImage').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}