@model IEnumerable<CMS.Backend.Controllers.OrderDemo>

@{
    ViewData["Title"] = "Dashboard Admin";
    // SỬA TÊN LAYOUT ĐÚNG VỚI TÊN TRONG THƯ MỤC SHARED
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <h2>Dashboard Demo</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card bg-primary text-white p-3">
                <h5>Tổng doanh thu</h5>
                <h3>@ViewBag.TotalRevenue.ToString("N0") VNĐ</h3>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white p-3">
                <h5>Số đơn hàng</h5>
                <h3>@ViewBag.TotalOrders</h3>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">Đơn hàng gần đây (Demo)</div>
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ngày</th>
                    <th>Khách hàng</th>
                    <th>Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.OrderDate</td>
                        <td>@item.CustomerName</td>
                        <td>@item.TotalAmount.ToString("N0") VNĐ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>