@model List<CMS.Data.Entities.Category>

@{
    ViewData["Title"] = "Danh sách danh mục sản phẩm/bài viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark font-weight-bold m-0 text-uppercase">BÀI TẬP 3: LIỆT KÊ DANH SÁCH CATEGORIES</h3>

        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Thêm danh mục mới
        </a>
    </div>

    <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
        <thead class="table-dark text-white">
            <tr>
                <th style="width: 100px;" class="text-center">ID</th>
                <th style="width: 250px;">Tên Danh Mục (Name)</th>
                <th>Mô Tả Chi Tiết (Description)</th>
                <th class="text-center" style="width: 160px;">Thao Tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center font-weight-bold text-secondary">@item.Id</td>
                        <td class="text-primary font-weight-bold">@item.Name</td>
                        <td class="text-muted">@item.Description</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm py-0 px-2 text-white">Sửa</a>

                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">
                                <button type="submit" class="btn btn-danger btn-sm py-0 px-2">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        Chưa có dữ liệu danh mục nào. Hãy nạp dữ liệu mẫu từ SQL Server!
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>