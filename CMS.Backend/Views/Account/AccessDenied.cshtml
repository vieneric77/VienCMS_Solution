@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Không có quyền truy cập</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            font-family: "Segoe UI", sans-serif;
        }

        .error-card {
            width: 100%;
            max-width: 420px;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,.15);
        }

        .error-header {
            background: #8BC34A;
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

            .error-header i {
                font-size: 55px;
                margin-bottom: 10px;
            }

            .error-header h3 {
                font-weight: bold;
                margin: 0;
            }

        .error-body {
            background: #F1F8E9;
            padding: 30px;
            text-align: center;
        }

            .error-body p {
                color: #558B2F;
                margin-bottom: 25px;
            }

        .btn-login {
            background: #8BC34A;
            border: none;
            color: white;
            font-weight: bold;
            padding: 10px 20px;
            border-radius: 10px;
            transition: .3s;
        }

            .btn-login:hover {
                background: #7CB342;
                color: white;
            }
    </style>
</head>

<body>

    <div class="error-card">

        <!-- HEADER -->
        <div class="error-header">
            <i class="bi bi-shield-x"></i>
            <h3>KHÔNG CÓ QUYỀN TRUY CẬP</h3>
        </div>

        <!-- BODY -->
        <div class="error-body">

            <h5 class="fw-bold text-success mb-2">
                Bạn không có quyền vào trang này
            </h5>

            <p>
                Vui lòng đăng nhập lại bằng tài khoản có quyền phù hợp.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-login w-100">

                <i class="bi bi-box-arrow-in-right me-1"></i>
                ĐĂNG NHẬP LẠI

            </a>

        </div>

    </div>

</body>
</html>