@model IEnumerable<CMS.Data.Entities.OrderDetail>
@{
    ViewData["Title"] = "Đơn hàng chi tiết";
    Layout = "_LayoutAdmin"; // Đảm bảo khớp với file Layout bạn gửi
}

<div class="container-fluid">
    <h2 class="my-4">Danh sách chi tiết đơn hàng</h2>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mã Đơn hàng</th>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-primary">
                                #@item.OrderId
                            </a>
                        </td>
                        <td>@(item.Product?.Name ?? "Sản phẩm đã xóa")</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                        <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">Chưa có dữ liệu chi tiết.</td>
                </tr>
            }
        </tbody>
    </table>
</div>