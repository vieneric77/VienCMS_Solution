@model CMS.Data.Entities.Post

<div class="container mt-4">
    <a asp-action="Index">Danh sách bài viết</a> / Chi tiết bài viết

    <h1 class="mt-3">@Model.Title</h1>

    @if (Model.Category != null)
    {
        <span class="badge bg-info">@Model.Category.Name</span>
    }

    <p class="text-muted">Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>

    <img src="@Model.ImageUrl" alt="Post Image" class="img-fluid" />

    <div class="mt-3">
        @Html.Raw(Model.Content)
    </div>
</div>