@model CMS.Data.Entities.Post
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Thêm bài viết mới";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white"><h4>THÊM BÀI VIẾT MỚI</h4></div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề:</label>
                            <input asp-for="Title" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nội dung:</label>
                            <textarea asp-for="Content" id="Content" class="form-control" rows="10"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chuyên mục:</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh đại diện:</label>
                            <input type="file" name="uploadImage" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-success">Lưu và Đăng</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor.create(document.querySelector('#Content')).catch(error => { console.error(error); });
    </script>
}