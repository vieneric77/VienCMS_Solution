@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHỈNH SỬA SẢN PHẨM</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm:</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả chi tiết sản phẩm:</label>
                            <textarea asp-for="Description" id="Description" class="form-control" rows="10"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục sản phẩm:</label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryList" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán (VNĐ):</label>
                            <input asp-for="Price" type="number" class="form-control" min="0" placeholder="0" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng tồn kho:</label>
                            <input asp-for="StockQuantity" type="number" class="form-control" min="0" placeholder="0" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh hiện tại:</label>
                            <div class="mb-2">
                                <img id="previewImage" src="@Model.ImageUrl" style="max-width: 100%; height: auto;" onerror="this.src='https://picsum.photos/400/250';" />
                            </div>
                            <label class="form-label">Chọn ảnh mới (nếu muốn thay đổi):</label>
                            <input type="file" name="uploadImage" id="fileInput" class="form-control" accept="image/*" onchange="previewSelectedImage(this)" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning text-white">
                                <i class="bi bi-save"></i> Cập nhật sản phẩm
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#Description'))
            .catch(error => {
                console.error(error);
            });

        // Hàm JavaScript bổ sung xử lý hiển thị ảnh tức thì ngay sau khi chọn tệp từ máy tính
        function previewSelectedImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImage').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}