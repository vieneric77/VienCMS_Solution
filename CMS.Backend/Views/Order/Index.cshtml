@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid mt-4">
    <h2>Danh sách Đơn hàng</h2>
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ngày</th>
                <th>Khách hàng</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.Customer?.FullName</td>
                    <td>
                        @if (item.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                        }
                        else if (item.Status == 1)
                        {

                            <span class="badge bg-primary">Đang giao</span>
                        }
                        else if (item.Status == 2)
                        {

                            <span class="badge bg-success">Đã xong</span>
                        }
                        else
                        {

                            <span class="badge bg-danger">Đã hủy</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info mb-1">Chi tiết</a>
                        <form asp-action="UpdateStatus" method="post" class="mt-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="" disabled selected>Chỉnh sửa...</option>
                                <option value="0">Chờ duyệt</option>
                                <option value="1">Đang giao</option>
                                <option value="2">Đã xong</option>
                                <option value="3">Đã hủy</option>
                            </select>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>