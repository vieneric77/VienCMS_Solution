@model List<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh Sách Bài Viết";
}

<div class="container mt-4">
    <h3 class="text-danger text-center font-weight-bold mb-4 text-uppercase">Danh Sách Bài Viết Mới Nhất</h3>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 200px; object-fit: cover;"
                             onerror="this.src='https://picsum.photos/400/250';">

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-info text-dark align-self-start mb-2">@(item.Category?.Name ?? "Chưa phân loại")</span>

                            <h5 class="card-title text-primary font-weight-bold">@item.Title</h5>

                            <p class="card-text text-secondary text-truncate" style="max-height: 50px;">
                                @item.Content
                            </p>

                            <p class="card-text mt-auto"><small class="text-muted">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</small></p>

                            <a href="#" class="btn btn-outline-primary btn-sm mt-2 align-self-start">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Chưa có bài viết nào trong hệ thống. Hãy thêm dữ liệu vào bảng dbo.Posts!</p>
            </div>
        }
    </div>
</div>