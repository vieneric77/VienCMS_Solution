@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản lý sách</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #ffffff;
            font-family: "Segoe UI", sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,.15);
        }

        /* Header */
        .login-header {
            background: #8BC34A;
            color: white;
            text-align: center;
            padding: 35px 20px;
        }

            .login-header i {
                font-size: 60px;
                margin-bottom: 10px;
            }

            .login-header h3 {
                font-weight: bold;
                margin-bottom: 8px;
            }

            .login-header p {
                margin: 0;
                opacity: .9;
            }

        /* Body */
        .login-body {
            background: #F1F8E9;
            padding: 35px;
        }

        .form-label {
            font-weight: 600;
            color: #33691E;
        }

        .form-control {
            height: 48px;
            border-radius: 10px;
            border: 1px solid #C5E1A5;
        }

            .form-control:focus {
                border-color: #8BC34A;
                box-shadow: 0 0 0 .2rem rgba(139,195,74,.25);
            }

        .input-group .btn {
            border-radius: 0 10px 10px 0;
            border-color: #C5E1A5;
        }

        /* Button */
        .btn-login {
            height: 48px;
            border-radius: 10px;
            border: none;
            background: #8BC34A;
            color: white;
            font-weight: bold;
            transition: .3s;
        }

            .btn-login:hover {
                background: #7CB342;
                color: white;
            }

        .footer-text {
            margin-top: 20px;
            text-align: center;
            color: #689F38;
            font-size: 14px;
        }

        .alert {
            border-radius: 10px;
        }
    </style>
</head>

<body>

    <div class="login-card">

        <div class="login-header">
            <i class="bi bi-book-half"></i>

            <h3>HỆ THỐNG QUẢN LÝ SÁCH</h3>

            <p>Book Management System</p>
        </div>

        <div class="login-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        <i class="bi bi-person-fill me-1"></i>
                        Tên đăng nhập
                    </label>

                    <input type="text"
                           name="username"
                           class="form-control"
                           placeholder="Nhập tên đăng nhập"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="mb-4">

                    <label class="form-label">
                        <i class="bi bi-key-fill me-1"></i>
                        Mật khẩu
                    </label>

                    <div class="input-group">

                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="btn btn-light border-0"
                                onclick="togglePassword()"
                                style="border-radius:0 10px 10px 0; background:#F1F8E9;">

                            <i class="bi bi-eye" id="eyeIcon"></i>

                        </button>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-login w-100">

                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    ĐĂNG NHẬP

                </button>

            </form>

            <div class="footer-text">
                <i class="bi bi-book me-1"></i>
                Quản lý thư viện • Quản lý sách • Quản lý độc giả
            </div>

        </div>

    </div>

    <script>
        function togglePassword() {

            const password = document.getElementById("password");
            const icon = document.getElementById("eyeIcon");

            if (password.type === "password") {
                password.type = "text";
                icon.className = "bi bi-eye-slash";
            } else {
                password.type = "password";
                icon.className = "bi bi-eye";
            }
        }
    </script>

</body>
</html>
```
