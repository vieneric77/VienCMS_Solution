<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Sách</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 280px;
            --sidebar-bg: #f8f9fa;
            --accent: #2d6a4f;
            --accent-hover: #1b4332;
            --text-main: #212529;
            --border: #dee2e6;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f4f7f6;
            margin: 0;
            color: var(--text-main);
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .sidebar-brand {
            padding: 25px;
            border-bottom: 1px solid var(--border);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: var(--accent);
        }

        .brand-icon {
            font-size: 24px;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 700;
            color: #000;
        }

        .nav-section-label {
            font-size: 11px;
            font-weight: 800;
            color: #adb5bd;
            padding: 20px 25px 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-item-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 25px;
            color: #495057;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: 0.3s;
        }

            .nav-item-link:hover {
                background: #e9ecef;
                color: var(--accent);
            }

            .nav-item-link.active {
                background: #d8f3dc;
                color: var(--accent);
                border-right: 3px solid var(--accent);
            }

            .nav-item-link i {
                font-size: 18px;
            }

        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: 70px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            z-index: 900;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: 70px;
            padding: 30px;
        }

        .user-panel {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-info {
            font-size: 13px;
            color: #495057;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-role {
            background: #e9ecef;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
            color: var(--accent);
            font-size: 11px;
        }

        .btn-topbar-logout {
            color: #d90429;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <a class="brand-logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half brand-icon"></i>
                <div class="brand-text">Thư Viện Số</div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Tổng quan</div>
            <a class="nav-item-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Bảng điều khiển</a>

            <div class="nav-section-label">Nội dung</div>
            <a class="nav-item-link" asp-controller="Category" asp-action="Index"><i class="bi bi-bookmark-fill"></i> Quản lý Danh mục</a>
            <a class="nav-item-link" asp-controller="Post" asp-action="Index"><i class="bi bi-journal-text"></i> Quản lý Bài viết</a>

            <div class="nav-section-label">Thương mại</div>
            <a class="nav-item-link" asp-controller="CategoryProduct" asp-action="Index"><i class="bi bi-tags"></i> Danh mục Sản phẩm</a>
            <a class="nav-item-link" asp-controller="Product" asp-action="Index"><i class="bi bi-book"></i> Sản phẩm (Sách)</a>
            <a class="nav-item-link" asp-controller="Customer" asp-action="Index"><i class="bi bi-person-badge"></i> Khách hàng</a>
            <a class="nav-item-link" asp-controller="Order" asp-action="Index"><i class="bi bi-cart-check"></i> Đơn hàng</a>

            <div class="nav-section-label">Hệ thống</div>
            <a class="nav-item-link" asp-controller="User" asp-action="Index"><i class="bi bi-shield-lock"></i> Quản lý Thành viên</a>
            <a class="nav-item-link" asp-controller="Banner" asp-action="Index"><i class="bi bi-image"></i> Quản lý Banner</a>
        </nav>
    </aside>

    <header class="topbar">
        <div class="h5 m-0 font-weight-bold">@(ViewData["Title"] ?? "Bảng điều khiển")</div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="user-panel">
                <div class="user-info">
                    <span>Xin chào, <strong>@User.FindFirst("FullName")?.Value</strong></span>
                    <span class="user-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
                <a class="btn-topbar-logout" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i> Thoát
                </a>
            </div>
        }
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.nav-item-link').forEach(link => {
            const href = link.getAttribute('href')?.toLowerCase();
            if (href && (path === href || (path.startsWith(href) && href !== '/'))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>