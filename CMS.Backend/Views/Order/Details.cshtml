@model CMS.Data.Entities.Order
@{
    Layout = "_LayoutAdmin"; ViewData["Title"] = "Chi tiết đơn hàng";
}
<div class="container mt-4">
    <h3>Chi tiết Đơn hàng #@Model.Id</h3>
    <p>Khách: <b>@Model.Customer?.FullName</b> | Ngày: @Model.OrderDate.ToString("dd/MM/yyyy")</p>
    <table class="table table-striped">
        <thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>