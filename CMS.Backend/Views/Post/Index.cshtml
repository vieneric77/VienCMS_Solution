@model List<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh Sách Bài Viết";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-danger font-weight-bold m-0 text-uppercase">Danh Sách Bài Viết Mới Nhất</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" style="height: 200px; object-fit: cover;"
                             onerror="this.src='https://picsum.photos/400/250';">

                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-info text-dark align-self-start mb-2">@(item.Category?.Name ?? "Chưa phân loại")</span>

                            <h5 class="card-title text-primary font-weight-bold">@item.Title</h5>

                            @* ĐÃ SỬA: Sử dụng Html.Raw để hiển thị đúng định dạng HTML thay vì hiển thị thẻ <p> *@
                            <div class="card-text text-secondary text-truncate" style="max-height: 50px;">
                                @Html.Raw(item.Content)
                            </div>

                            <p class="card-text mt-auto"><small class="text-muted">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</small></p>

                            <div class="mt-2">
                                <a href="/Post/Details/@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Chưa có bài viết nào trong hệ thống. Hãy thêm dữ liệu vào bảng dbo.Posts!</p>
            </div>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="row mt-4">
            <div class="col-12">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-id="@ViewBag.CategoryId"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>