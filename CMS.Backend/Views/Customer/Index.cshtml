@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid mt-4">
    <h2>Danh sách Khách hàng</h2>
    <form method="get" class="mb-3">
        <input type="text" name="searchString" placeholder="Tìm tên hoặc email..." class="form-control d-inline w-25" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>SĐT</th>
                <th>Địa chỉ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">Sửa</a>
                        <a asp-action="Orders" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Đơn hàng</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Xóa?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>